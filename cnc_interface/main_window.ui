     <property name="styleSheet">
      <string notr="true">QTabWidget::pane {
    border: 3px solid #FE5C0D;
    background: #161616;
    border-radius: 10px;
    top: -3px; 
}

QTabBar::tab {
    background: #252525; 
    color: white;
    border: 2px solid #FE5C0D;
    border-bottom: none; 
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 3px 20px;
}

QTabBar::tab:selected {
    background: #161616; 
    border-bottom: 2px solid #161616; 
	color: #FE5C0D;
    font-weight: bold;
}

QTabBar::tab:hover {
    background: #333333;
}</string>

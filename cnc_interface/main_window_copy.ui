	border-radius: 10px;
	border: 3px solid #333333;
}

QSlider::handle:horizontal {
    background: #FE5C0D;
    width: 18px;
    height: 18px;
    margin: -6px 0; 
    border-radius: 9px; 
}

QSlider::handle:horizontal:hover {
	background-color: rgb(254, 81, 13);
    border: 2px solid rgb(254, 174, 13);
}

QSlider::sub-page:horizontal {
    background: #161616;
    height: 8px;
    border-radius: 9px;
}

QSlider::add-page:horizontal {
    background: #161616;
    border: 1px solid #333333;
    height: 8px;
    border-radius: 9px;
}</string>
